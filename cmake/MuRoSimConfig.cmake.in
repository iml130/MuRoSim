# find_package(MuRoSim) entry point. Provides the imported targets
# MuRoSim::murosim, MuRoSim::murosimrl and MuRoSim::murosimproc.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Public dependencies of murosim
find_dependency(Eigen3 CONFIG)
find_dependency(Threads)

# EGL, GLES and GLFW come from pkg-config. Missing ones make MuRoSim "not
# found" rather than aborting the configure, so find_package(MuRoSim) without
# REQUIRED stays optional.
find_dependency(PkgConfig)
set(_murosim_pkg_quiet)
if(${CMAKE_FIND_PACKAGE_NAME}_FIND_QUIETLY)
    set(_murosim_pkg_quiet QUIET)
endif()
foreach(_murosim_pkg EGL:egl GLESv2:glesv2 GLFW3:glfw3)
    string(REPLACE ":" ";" _murosim_pkg "${_murosim_pkg}")
    list(GET _murosim_pkg 0 _murosim_prefix)
    list(GET _murosim_pkg 1 _murosim_module)
    pkg_check_modules(${_murosim_prefix} ${_murosim_pkg_quiet} IMPORTED_TARGET ${_murosim_module})
    if(NOT ${_murosim_prefix}_FOUND)
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "MuRoSim needs the pkg-config module '${_murosim_module}' (see dependencies.txt).")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        return()
    endif()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/MuRoSimTargets.cmake")

# find_package(MuRoSim COMPONENTS ...) accepts the three library names.
foreach(_murosim_component IN ITEMS murosim murosimrl murosimproc)
    set(${CMAKE_FIND_PACKAGE_NAME}_${_murosim_component}_FOUND TRUE)
endforeach()
foreach(_murosim_component IN LISTS ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
    if(NOT ${CMAKE_FIND_PACKAGE_NAME}_${_murosim_component}_FOUND)
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "Unknown component '${_murosim_component}'; MuRoSim provides murosim, murosimrl and murosimproc.")
    endif()
endforeach()

check_required_components(MuRoSim)
