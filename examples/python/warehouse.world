#
# A small warehouse hall for examples/python/world_file.py: a 12 x 8 m room
# with two shelf rows, which leaves three aisles along the x axis.
#
# The .world format is plain text, one record per line, units in metres,
# angles in degrees. Blank lines and lines starting with '#' are ignored;
# a record must not carry anything after its last field.
#
#   l x1 y1 x2 y2                                wall segment
#   c x y r                                      round obstacle
#   n x y r start_angle start_bias id group      navigation node
#
# A node is a place a robot can start at or be sent to. Its radius doubles
# as the goal radius, a start heading is drawn uniformly from
# start_angle +/- start_bias / 2 (start_bias is the full width of the range),
# and ids must be unique (this is not checked). InitMode.NODE_GROUP_RANDOM
# pairs start and goal within one group; every group, 0 included, then needs
# at least two nodes. Group 0 is the default and the only one the other init
# modes look at.

# outer walls
l 0 0 12 0
l 12 0 12 8
l 12 8 0 8
l 0 8 0 0

# lower shelf row, a closed rectangle
l 3 2.5 9 2.5
l 9 2.5 9 3.5
l 9 3.5 3 3.5
l 3 3.5 3 2.5

# upper shelf row
l 3 4.5 9 4.5
l 9 4.5 9 5.5
l 9 5.5 3 5.5
l 3 5.5 3 4.5

# two pillars at the ends of the middle aisle
c 0.5 4 0.25
c 11.5 4 0.25

# group 1: lower aisle, robots start facing +x
n 1.5 1.25 0.4 0 30 0 1
n 6 1.25 0.4 0 30 1 1
n 10.5 1.25 0.4 0 30 2 1

# group 2: middle aisle between the shelves
n 1.5 4 0.4 0 30 3 2
n 10.5 4 0.4 180 30 4 2

# group 3: upper aisle, robots start facing -x
n 1.5 6.75 0.4 180 30 5 3
n 6 6.75 0.4 180 30 6 3
n 10.5 6.75 0.4 180 30 7 3
